<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="Version.props"/>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>WinExe</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Numos.Viewer</RootNamespace>
        <AssemblyName>Numos.Viewer</AssemblyName>
        <PackageId>Numos.Viewer</PackageId>
        <Title>Numos Simulation Viewer</Title>
        <Description>Interactive raylib and ImGui viewer for Numos atmospherics simulations.</Description>
        <PackageTags>simulation;atmospherics;visualization;raylib;imgui;nativeaot</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GenerateNumosBuildInfo>true</GenerateNumosBuildInfo>
        <NumosReleaseTagPrefix>viewer</NumosReleaseTagPrefix>
        <NumosSourceReference Condition="'$(ViewerSourceReference)' != ''">$(ViewerSourceReference)</NumosSourceReference>
    </PropertyGroup>

    <ItemGroup>
        <!-- PrivateAssets="none" lets the Numos.API source generator reach consumers of this package. -->
        <ProjectReference Include="..\Numos.API\Numos.API.csproj" PrivateAssets="none"/>
        <ProjectReference Include="..\Numos.SimDrawer\Numos.SimDrawer.csproj"/>
        <ProjectReference Include="..\Numos.Workbench\Numos.Workbench.csproj" PrivateAssets="none"/>
        <ProjectReference Include="..\Numos.Serialization\Numos.Serialization.csproj" PrivateAssets="none"/>
        <ProjectReference Include="..\Numos.Serialization.FileSystem\Numos.Serialization.FileSystem.csproj" PrivateAssets="none"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Linguini.Bundle" Version="0.11.0" />
        <PackageReference Include="NativeFileDialogNET" Version="2.0.2"/>
        <PackageReference Include="Raylib-cs" Version="7.0.2"/>
        <PackageReference Include="rlImgui-cs" Version="3.2.0"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="assets/icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Pack>true</Pack>
            <PackagePath>contentFiles/any/any/assets/icon.png</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </None>
        <None Update="assets/imgui-default.ini">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Pack>true</Pack>
            <PackagePath>contentFiles/any/any/assets/imgui-default.ini</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </None>
        <None Update="assets/ProggyClean.ttf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Pack>true</Pack>
            <PackagePath>contentFiles/any/any/assets/ProggyClean.ttf</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </None>
        <None Update="locale/**/*.ftl">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Pack>true</Pack>
            <PackagePath>contentFiles/any/any/locale/**/*.ftl</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </None>
    </ItemGroup>

</Project>
