<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>WinExe</OutputType>
        <RootNamespace>Numos.Viewer</RootNamespace>
        <AssemblyName>Numos.Viewer</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Numos.API\Numos.API.csproj"/>
        <ProjectReference Include="..\Numos.SimDrawer\Numos.SimDrawer.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Raylib-cs" Version="7.0.2"/>
        <PackageReference Include="rlImgui-cs" Version="3.2.0"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="assets/icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Update="assets/imgui-default.ini">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

</Project>
