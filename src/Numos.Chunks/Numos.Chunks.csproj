    <ItemGroup>
        <ProjectReference Include="..\Numos.Collections\Numos.Collections.csproj"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    </ItemGroup>

</Project>
