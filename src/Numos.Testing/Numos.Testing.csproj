<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\Numos.CoreSim\Version.props"/>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>Numos.Testing</PackageId>
        <Title>Numos Testing</Title>
        <Description>Framework-independent determinism checks for Numos worlds and custom solvers.</Description>
        <PackageTags>simulation;atmospherics;replay;determinism;testing;nativeaot</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <!-- PrivateAssets="none" lets the Numos.API source generator reach consumers of this package. -->
        <ProjectReference Include="..\Numos.API\Numos.API.csproj" PrivateAssets="none"/>
        <ProjectReference Include="..\Numos.Serialization\Numos.Serialization.csproj" PrivateAssets="none"/>
    </ItemGroup>
</Project>
