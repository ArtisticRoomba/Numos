<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\Numos.CoreSim\Version.props"/>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Numos.API</RootNamespace>
        <PackageId>Numos.API</PackageId>
        <Title>Numos API</Title>
        <Description>Supported public API for Numos, an engine-agnostic, pseudo-realistic, voxel-based atmospherics simulation library.</Description>
        <PackageTags>simulation;atmospherics;voxel;nativeaot</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Numos.CoreSim\Numos.CoreSim.csproj"/>
        <ProjectReference Include="..\Numos.Replay.Generators\Numos.Replay.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained"/>
        <!-- Built here so pack can ship it under analyzers/; it isn't a dependency of the package. -->
        <ProjectReference Include="..\Numos.API.Generators\Numos.API.Generators.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"
                          GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained"/>
    </ItemGroup>

    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackNumosApiGenerators</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <!-- Pack calls this with TargetFramework set globally, so strip it before asking the netstandard2.0 generator
         project where its output is. -->
    <Target Name="_PackNumosApiGenerators">
        <MSBuild Projects="..\Numos.API.Generators\Numos.API.Generators.csproj"
                 Targets="GetTargetPath"
                 RemoveProperties="TargetFramework;RuntimeIdentifier;PublishAot;PublishTrimmed;SelfContained">
            <Output TaskParameter="TargetOutputs" ItemName="_NumosApiGeneratorAssembly"/>
        </MSBuild>
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(_NumosApiGeneratorAssembly)" PackagePath="analyzers/dotnet/cs"/>
        </ItemGroup>
    </Target>

</Project>
