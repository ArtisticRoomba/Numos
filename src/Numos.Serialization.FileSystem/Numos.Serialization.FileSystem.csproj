<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\Numos.CoreSim\Version.props"/>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>Numos.Serialization.FileSystem</PackageId>
        <Title>Numos Serialization FileSystem</Title>
        <Description>Optional filesystem helpers for Numos replay documents.</Description>
        <PackageTags>simulation;atmospherics;replay;filesystem;nativeaot</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <!-- PrivateAssets="none" lets the Numos.API source generator reach consumers of this package. -->
        <ProjectReference Include="..\Numos.Serialization\Numos.Serialization.csproj" PrivateAssets="none"/>
    </ItemGroup>
</Project>
