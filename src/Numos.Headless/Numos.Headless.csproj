<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\Numos.Viewer\Version.props"/>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
        <RootNamespace>Numos.Headless</RootNamespace>
        <AssemblyName>Numos.Headless</AssemblyName>
        <GenerateNumosBuildInfo>true</GenerateNumosBuildInfo>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Numos.API\Numos.API.csproj"/>
        <ProjectReference Include="..\Numos.Workbench\Numos.Workbench.csproj"/>
    </ItemGroup>

</Project>
